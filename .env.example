# =====================================================================
# SheetLayout AI — Environment Configuration
# =====================================================================

# 1. Supabase Database Configuration (Replaces local storage)
# Get your Project URL and anon / service_role key from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Optional: Dedicated Service Role Key (recommended for running upload_to_supabase.py)
SUPABASE_SERVICE_ROLE_KEY=

# 2. AI Intelligence Engine
# Google Gemini API Key for conversational AI Q&A across sheet data
GEMINI_API_KEY=
